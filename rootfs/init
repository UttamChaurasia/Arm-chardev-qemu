#!/bin/sh
# PID 1 inside the initramfs.
export PATH=/bin:/sbin
mount -t proc     none /proc
mount -t sysfs    none /sys
mount -t devtmpfs none /dev

echo
echo "=== mychardev ARM/QEMU environment ($(uname -srm)) ==="

if grep -q autotest /proc/cmdline; then
    /bin/selftest.sh
    echo "=== selftest finished, powering off ==="
    poweroff -f
fi

cat <<'MSG'
Try:
  hello
  insmod /lib/modules/chardev.ko ; dmesg | tail
  echo hello > /dev/mychardev ; cat /dev/mychardev
  chardev_test
  rmmod chardev
Power off:  poweroff -f
MSG
exec setsid cttyhack sh
