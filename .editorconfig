root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Linux kernel coding style: tabs, 8 wide
[*.{c,h}]
indent_style = tab
indent_size = 8

[Makefile]
indent_style = tab

[*.{sh,gdb}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
